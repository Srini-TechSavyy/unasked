{
  "name": "unasked",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply unasked-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply unasked-db --remote",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "marked": "^18.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.141.0"
  }
}
